000000,"name":"幻化術","to":3},{"id":4000001,"name":"鷹之眼","to":8},{"id":4001334,"name":"劈空斬","to":20},{"id":4000000,"name":"幻化術","to":20},{"id":4001002,"name":"詛咒術","to":3},{"id":4001003,"name":"隱身術","to":10}]},{"label":"舊版・雙修賊 30 等成形（兩版）","main":false,"v":"legacy","s":["https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=4675","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=676"],"steps":[{"id":4001344,"name":"雙飛斬","to":1},{"id":4000000,"name":"幻化術","to":3},{"id":4000001,"name":"鷹之眼","to":8},{"id":4001344,"name":"雙飛斬","to":20},{"id":4001002,"name":"詛咒術","to":3},{"id":4001003,"name":"隱身術","to":10,"note":"版本二改隱身術 20、幻化術 10（作者推崇）"},{"id":4000000,"name":"幻化術","to":20}]}],"train":[{"from":10,"to":13,"kind":"solo","map":102040001,"name":"教官任務（木妖／黑木妖／三眼章魚）","mobs":[130100,1110101,1120100],"why":"噗貓：一轉後先解轉職教官 10／11／12／13 等任務（擊殺 20／50／80 隻木妖與 10 隻三眼章魚），拿藥水獎勵再出發。楓錄達人路線同（10～13 等先解教官新手任務拿藥水）。","v":"tw","s":["https://home.gamer.com.tw/artwork.php?sn=6375411","https://mapleclassictools.com/"]},{"from":10,"to":25,"kind":"party","map":null,"name":"月妙組隊任務（速刷，不打肥肥）","mobs":[1210100,1210101,4230103],"why":"〈鏢賊心得〉：10～25 全部在月妙，經驗最高又能賺錢（肥肥頭 4 萬上下）。〈標賊前期賺錢〉回覆：月妙不是 AOE 不要打肥肥、速刷 1,600 經驗超省水，找組時喊「月妙速刷」避開肥肥團；月妙平台太小一次三隻要跳打。噗貓：月妙重點在獎勵地圖掉落率異常高。","v":"tw","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=2076","https://forum.gamer.com.tw/C.php?bsn=85994&snA=1483","https://home.gamer.com.tw/artwork.php?sn=6375411","https://bobogameguides.com/maplestory-classic/guides/leveling-routes.html"],"pq":"moon"},{"from":10,"to":17,"kind":"solo","map":100020000,"name":"弓箭手村東部草叢 肥肥、緞帶肥肥","mobs":[1210100,1210101],"why":"噗貓：長條形地圖只有肥肥與緞帶肥肥，能提早收肥肥頭，上面有休息平台。舊版〈標賊練功心得1~70〉：維多利亞三叉路右上三個平台打肥肥到 17，站平台幾乎不扣血。","v":"tw","s":["https://home.gamer.com.tw/artwork.php?sn=6375411","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=1016"]},{"from":13,"to":20,"kind":"solo","map":104010001,"name":"肥肥海岸 肥肥、緞帶肥肥","mobs":[1210100,1210101],"why":"經典版〈新手1~30練功〉：13 級左右能一個技能秒肥肥就蠻快；波波板上：組不到隊 13 等可單練。舊版多篇列 15～25 肥肥海岸但人多。","v":"community","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=304","https://bobogameguides.com/maplestory-classic/guides/leveling-routes.html","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=199","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=881"]},{"from":17,"to":22,"kind":"solo","map":102040001,"name":"北方工地頂端 三眼章魚","mobs":[1120100],"why":"噗貓：盜賊二轉教官旁電線杆進隱藏圖，總經驗比月妙高一點點。舊版〈俠盜1~70練功心法〉：10～15（甚至到 20）北方工地頂端或小心掉落，三眼章魚多到清不完，純刀跳下去戳、雙修站卡點放鏢很省水。","v":"tw","s":["https://home.gamer.com.tw/artwork.php?sn=6375411","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=4675"]},{"from":20,"to":25,"kind":"solo","map":103010001,"name":"小心掉落 三眼章魚","mobs":[1120100],"why":"楓錄達人路線（劍士視角）：20～25 等站平台無傷打三眼章魚（留 100 個章魚腳交內拉任務）；舊版俠盜文列為 10～20 盜賊補點。","v":"community","s":["https://mapleclassictools.com/","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=4675"]},{"from":22,"to":28,"kind":"solo","map":105050000,"name":"螞蟻洞Ⅰ 刺菇菇、殭屍菇菇","mobs":[2110200,2230101],"why":"噗貓：刺菇菇跟殭屍菇菇非常密集，水錢消耗明顯增加。舊版〈刀賊1~30〉推刀賊走螞蟻洞Ⅳ入口平台（人少、殭屍菇菇會跳樓、詛咒＋普攻不賠錢，可練到 30 甚至二轉後）；〈刺客11～45〉：20～40 刺菇菇能秒時最好練（HP 300）。","v":"tw","s":["https://home.gamer.com.tw/artwork.php?sn=6375411","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=189","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=223"]},{"from":21,"to":30,"kind":"party","map":103000804,"name":"超級綠水靈組隊任務（墮落城市）","mobs":[9300003,3110100,3230100,2130103],"why":"〈鏢賊心得〉：25～30 推超綠（或繼續月妙），黏呼呼鞋子對全幸很重要、可拚套敏 10%。〈標賊前期賺錢〉回覆：21 等鏢賊就能打鱷魚、風獨眼、青蛇（234 關會跳就行），一開始打王別下去，25 等換狼牙再下去打王，一場四分多鐘；21 等賊很少人組要自己當隊長。〈新手1~30〉：鏢賊是超綠除法師外唯一能穩定輸出的職業（雙飛斬固定 50% 熟練）。","v":"tw","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=2076","https://forum.gamer.com.tw/C.php?bsn=85994&snA=1483","https://forum.gamer.com.tw/C.php?bsn=85994&snA=304","https://bobogameguides.com/maplestory-classic/guides/leveling-routes.html"],"pq":"kerning"},{"from":25,"to":30,"kind":"solo","map":101040001,"name":"黑肥肥領土 黑肥肥","mobs":[2230102,3230300],"why":"〈標賊前期賺錢〉回覆：25 等後打黑肥肥才是正收益。噗貓：28～38 黑肥肥領土，打掉最上面祭壇可一口氣清掉幼魔精靈。經典版 YouTuber 攻略：怪密集、重生快、適合組隊。","v":"tw","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=1483","https://home.gamer.com.tw/artwork.php?sn=6375411","https://forum.gamer.com.tw/C.php?bsn=85994&snA=731"]},{"from":20,"to":30,"kind":"solo","map":100040100,"name":"智慧森林／弓箭手訓練場 綠菇菇","mobs":[1110100,210100],"why":"舊版〈標賊練功心得1~70〉：20～30 智慧森林殺綠菇與綠水靈，有錢開雙飛、沒錢慢慢丟；〈刀賊1~30〉：22 等換武器後到魔森北部森林訓練場Ⅳ打綠菇菇（偏遠不熱門、2 劈 1 砍）。","v":"legacy","s":["https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=1016","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=189","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=199"]},{"from":10,"to":20,"kind":"solo","map":101010100,"name":"大木林Ⅰ／南部森林訓練場Ⅰ 綠水靈；墮落城市南方工地 菇菇寶貝","mobs":[210100,1210102],"why":"舊版多篇：10～17 綠水靈（大木林Ⅰ上方有可站著回血的區塊）；有錢者 10 等換拳套帶鏢去墮落城市南方工地打菇菇寶貝；17～20 工地菇菇寶貝比肥肥海岸省水。","v":"legacy","s":["https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12555&sn=189","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=954","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=762","https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=222"]}],"notes":[{"t":"經典版沒有初心者骰子與自由配點（基底 08 年版本），轉職前自動配點、轉職時重置。","s":["https://home.gamer.com.tw/artwork.php?sn=6375411","https://bobogameguides.com/maplestory-classic/guides/skills-overview.html"]},{"t":"幾等換刀是公開爭議：有人 37～38 等拿刀（迴旋 11 就拿）、有人推 43（精準 19＋迴旋 21＝40 點，扣轉職送 1 點）或 46 等；也有人完全不建議投擲過渡。","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=115","https://bobogameguides.com/maplestory-classic/guides/jobs-overview.html"]},{"t":"跳射：怪太近時往反方向跳、空中轉身再射；鱷魚類近距離跳射要抓半拍節奏；等身怪跳高於頭頂再按攻擊；石巨人／月牛等超高怪只能拉回身再射。","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=1483"]},{"t":"前期錢：鏢賊很耗魔（1 MP≈2 楓幣、3 鏢≈1 楓幣），一轉靠自帶熟練的雙飛斬打對怪、多解任務、喝攻擊藥水；每天賣名聲。","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=1483"]},{"t":"詛咒術在經典版兩賊都用不到（純為隱身術前置）；詛咒術對王無效。","s":["https://forum.gamer.com.tw/C.php?bsn=85994&snA=1418"]}],"gaps":[],"notOpenYet":[{"from":10,"to":20,"place":"新葉城測驗、泰國水上市場守護隊（全幸標賊舊版路線）","s":["https://forum.gamer.com.tw/G2.php?bsn=7650&parent=12553&sn=3551"]}]}